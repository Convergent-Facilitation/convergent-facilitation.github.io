---
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
<link href="https://fonts.googleapis.com/css2?family=Asul:wght@400;700&family=Quattrocento+Sans:ital,wght@0,400;0,700;1,400;1,700&display=swap" rel="stylesheet" />

<style is:inline>
  :root {
    --aw-font-sans: 'Asul', sans-serif;
    --aw-font-serif: 'Asul', serif;
    --aw-font-heading: 'Quattrocento Sans', sans-serif;

    --aw-color-primary: #8a1744;
    --aw-color-secondary: #681033;
    --aw-color-accent: #8a1744;

    --aw-color-text-heading: #8a1744;
    --aw-color-text-default: #050404;
    --aw-color-text-muted: #555555;
    --aw-color-text-page: #050404;

    --aw-color-bg-page: #ffffff;
    --aw-color-bg-page-dark: #181218;

    ::selection {
      background-color: #8a1744;
      color: #ffffff;
    }
  }

  .dark {
    --aw-font-sans: 'Asul', sans-serif;
    --aw-font-serif: 'Asul', serif;
    --aw-font-heading: 'Quattrocento Sans', sans-serif;

    --aw-color-primary: #8a1744;
    --aw-color-secondary: #681033;
    --aw-color-accent: #e5a0bd;

    --aw-color-text-heading: #f7f8f8;
    --aw-color-text-default: #e5ecf6;
    --aw-color-text-muted: #c3bdc1;
    --aw-color-text-page: #e5ecf6;

    --aw-color-bg-page: #181218;

    ::selection {
      background-color: #8a1744;
      color: #ffffff;
    }
  }
</style>
