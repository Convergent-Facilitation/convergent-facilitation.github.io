<style is:inline>
  /* Asul – Regular */
  @font-face {
    font-family: 'Asul';
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url('/fonts/asul/asul-latin-400-normal.woff2') format('woff2');
  }

  /* Asul – Bold */
  @font-face {
    font-family: 'Asul';
    font-style: normal;
    font-weight: 700;
    font-display: swap;
    src: url('/fonts/asul/asul-latin-700-normal.woff2') format('woff2');
  }

  /* Quattrocento Sans – Latin Extended Regular */
  @font-face {
    font-family: 'Quattrocento Sans';
    font-style: normal;
    font-weight: 400;
    font-display: swap;
