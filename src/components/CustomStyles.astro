  :root {
    --aw-font-sans: 'Asul', sans-serif;
    --aw-font-serif: 'Asul', serif;
    --aw-font-heading: 'Quattrocento Sans', sans-serif;

    --aw-color-primary: #8A1744;
    --aw-color-secondary: #444444;
    --aw-color-accent: #8A1744;

    --aw-color-light-magenta: #8a17442e;
    --aw-color-grey-medium: #808080;
    --aw-color-grey-dark: #444444;
    --aw-color-grey: #777777;
    --aw-color-grey-border: #C9C9C9;
    --aw-color-grey-light: #C1C1C1;
    --aw-color-grey-lighter: #F1EFF0;

    --aw-color-text-heading: #8A1744;
    --aw-color-text-default: #050404;
    --aw-color-text-muted: #444444;
    --aw-color-text-page: #050404;

    --aw-color-bg-page: #FFFFFF;
    --aw-color-bg-page-dark: #181218;

    ::selection {
      background-color: #8A1744;
      color: #FFFFFF;
    }
  }

  .dark {
