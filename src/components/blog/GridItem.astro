---
import { APP_BLOG } from 'astrowind:config';
import type { Post } from '~/types';

import Image from '~/components/common/Image.astro';

import { findImage } from '~/utils/images';
import { getPermalink } from '~/utils/permalinks';

export interface Props {
  post: Post;
}

const { post } = Astro.props;
const image = await findImage(post.image);

const link = post.externalUrl || (APP_BLOG?.post?.isEnabled ? getPermalink(post.permalink, 'post') : '');

const preserveImage = typeof post.image === 'string' &&
  post.image.endsWith('NGL_logo_900x506.png');
---

<article class="mb-6 transition">
  <div class={preserveImage
    ? 'relative rounded shadow-lg mb-6'
    : 'relative md:h-64 bg-gray-400 dark:bg-[#302830] rounded shadow-lg mb-6'}>
    {
      image &&
        (link ? (
          <a href={link}>
            <Image
              src={image}
              class={preserveImage
                ? 'block w-full h-auto object-contain rounded'
                : 'w-full md:h-full rounded shadow-lg bg-gray-400 dark:bg-[#302830]'}
              widths={[400, 900]}
              width={400}
              sizes="(max-width: 900px) 400px, 900px"
              alt={post.title}
              {...(preserveImage ? {} : { aspectRatio: '16:9', layout: 'cover' })}
              loading="lazy"
              decoding="async"
            />
          </a>
        ) : (
          <Image
            src={image}
            class={preserveImage
              ? 'block w-full h-auto object-contain rounded'
              : 'w-full md:h-full rounded shadow-lg bg-gray-400 dark:bg-[#302830]'}
            widths={[400, 900]}
            width={400}
            sizes="(max-width: 900px) 400px, 900px"
            alt={post.title}
            {...(preserveImage ? {} : { aspectRatio: '16:9', layout: 'cover' })}
            loading="lazy"
            decoding="async"
          />
        ))
    }
  </div>

  <h3 class="text-xl sm:text-2xl font-bold leading-tight mb-2 font-heading dark:text-[#E58BAB]">
    {
      link ? (
        <a
          class="inline-block hover:text-primary dark:text-[#E58BAB] dark:hover:text-[#F3B5CC] transition ease-in duration-200"
          href={link}
        >
          {post.title}
        </a>
      ) : (
        post.title
      )
    }
  </h3>

  <p class="text-muted dark:text-[#C1C1C1] text-lg">{post.excerpt}</p>
</article>
