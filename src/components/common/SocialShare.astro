---
import { Icon } from 'astro-icon/components';

export interface Props {
  text: string;
  url: string | URL;
  class?: string;
}

const { text, url, class: className = 'inline-block' } = Astro.props;

const iconClass =
  'w-6 h-6 text-primary hover:text-secondary dark:text-[#C1C1C1] dark:hover:text-white transition-colors duration-200';
---

<div class={className}>
  <span class="align-super font-bold text-muted dark:text-[#C1C1C1]">Share:</span>

  <button
    class="ml-2 rtl:ml-0 rtl:mr-2"
    title="Share on X"
    aria-label="Share on X"
    data-aw-social-share="twitter"
    data-aw-url={url}
    data-aw-text={text}
  >
    <Icon name="tabler:brand-x" class={iconClass} />
  </button>

  <button
    class="ml-2 rtl:ml-0 rtl:mr-2"
    title="Share on Facebook"
    aria-label="Share on Facebook"
    data-aw-social-share="facebook"
    data-aw-url={url}
  >
    <Icon name="tabler:brand-facebook" class={iconClass} />
  </button>

  <button
    class="ml-2 rtl:ml-0 rtl:mr-2"
    title="Share on LinkedIn"
    aria-label="Share on LinkedIn"
    data-aw-social-share="linkedin"
    data-aw-url={url}
    data-aw-text={text}
  >
    <Icon name="tabler:brand-linkedin" class={iconClass} />
  </button>

  <button
    class="ml-2 rtl:ml-0 rtl:mr-2"
    title="Share on WhatsApp"
    aria-label="Share on WhatsApp"
    data-aw-social-share="whatsapp"
    data-aw-url={url}
    data-aw-text={text}
  >
    <Icon name="tabler:brand-whatsapp" class={iconClass} />
  </button>

  <button
    class="ml-2 rtl:ml-0 rtl:mr-2"
    title="Share by email"
    aria-label="Share by email"
    data-aw-social-share="mail"
    data-aw-url={url}
    data-aw-text={text}
  >
    <Icon name="tabler:mail" class={iconClass} />
  </button>
</div>
